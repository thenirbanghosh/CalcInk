{
  "name": "calcink",
  "version": "1.0.0",
  "private": true,
  "description": "Handwritten math calculator that runs in the browser and works offline",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "eval": "node --experimental-strip-types scripts/eval/run-eval.ts",
    "check": "npm run typecheck && npm run test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "onnxruntime-web": "^1.30.0",
    "perfect-freehand": "^1.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.2",
    "onnxruntime-node": "^1.30.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3",
    "workbox-window": "^7.4.1"
  },
  "allowScripts": {
    "onnxruntime-node@1.30.0": true
  }
}
